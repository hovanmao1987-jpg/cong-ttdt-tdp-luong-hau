---
/**
 * ThuVienDuLieuChiBo.astro
 * Mô-đun: "Thư viện Dữ liệu Chi bộ" - Cổng TTĐT & Nội bộ TDP Lương Hậu
 * Nguyên tắc: BẢO TOÀN TUYỆT ĐỐI (NON-DESTRUCTIVE UPDATE)
 * - CSS Scoped độc lập (.tvcb-*) tránh xung đột 100% với CSS bên ngoài.
 * - Liên kết động trực tiếp tới 6 thư mục Google Drive nhánh + 1 thư mục gốc.
 * - Thiết kế phẳng, bo góc 20px (18px-24px), đổ bóng nhẹ.
 * - Cột trái Xanh lá (#0e8360), Cột phải Tím lam (#6366f1).
 */
interface Props {
  id?: string;
  class?: string;
}

const { id = "ho-so-noi-bo", class: className = "" } = Astro.props;

// Danh mục dữ liệu thư mục Google Drive chuẩn theo cấu hình
const ROOT_FOLDER = {
  name: "THƯ VIỆN HỒ SƠ CHI BỘ",
