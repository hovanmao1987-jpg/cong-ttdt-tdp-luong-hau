---
/**
 * src/components/ChuNhatXanhSection.astro
 * Component Astro thuần không phụ thuộc react runtime
 */
import data from "../data/du-lieu-moi.json";

const { chuNhatXanh } = data;
---

<div style="width:100%; max-width:1100px; margin:20px auto; padding:20px; background:#fff; border-radius:16px; box-shadow:0 4px 20px rgba(16,185,129,0.08); border:1px solid #a7f3d0;">
  <div style="display:flex; align-items:center; gap:12px; border-bottom:2px solid #a7f3d0; padding-bottom:14px; margin-bottom:20px;">
    <span style="font-size:32px; line-height:1;">🌱</span>
    <div>
      <h2 style="font-size:18px; font-weight:800; color:#065f46; text-transform:uppercase; margin:0 0 4px 0;">
        Phong trào Ngày Chủ Nhật Xanh - Tổ Dân Phố Lương Hậu
      </h2>
      <p style="font-size:13px; color:#475569; margin:0;">
        Hành động vì môi trường "Xanh - Sạch - Sáng" tuyến đường Thái Thuận &amp; Thái Vĩnh Chinh
      </p>
    </div>
  </div>

  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(290px, 1fr)); gap:18px;">
    {chuNhatXanh.map((item) => (
      <div style="background:#f0fdf4; border-radius:12px; padding:16px; border:1px solid #bbf7d0; display:flex; flex-direction:column; justify-content:space-between;">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
            <span style="background:#059669; color:#fff; font-size:11px; font-weight:bold; padding:2px 8px; border-radius:12px;">
              📅 {item.thoiGian}
            </span>
          </div>
          <h3 style="font-size:14.5px; font-weight:700; color:#0f172a; margin:0 0 8px 0; line-height:1.4;">
            {item.tieuDe}
          </h3>
          <p style="font-size:12px; font-weight:600; color:#047857; margin:0 0 6px 0;">
            📍 {item.diaDiem}
          </p>
          <p style="font-size:12.5px; color:#334155; line-height:1.6; margin:0;">
            {item.noiDung}
          </p>
        </div>
        <div style="margin-top:14px; padding-top:10px; border-top:1px dashed #a7f3d0; display:flex; justify-content:space-between; align-items:center; font-size:12px; color:#047857; font-weight:600;">
          <span>📸 {item.hinhAnh.length} ảnh hoạt động</span>
          <span style="color:#059669;">Lưu trữ nội bộ ✓</span>
        </div>
      </div>
    ))}
  </div>
</div>
