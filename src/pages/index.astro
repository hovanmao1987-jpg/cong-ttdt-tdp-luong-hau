  <!-- ==================== JAVASCRIPT ==================== -->
  <script>
    const btnOpenMenu = document.getElementById("btn-open-menu");
    const btnFloatingMenu = document.getElementById("btn-floating-menu");
    const btnCloseMenu = document.getElementById("btn-close-menu");
    const drawerNav = document.getElementById("drawer-nav");
    const drawerBackdrop = document.getElementById("drawer-backdrop");

    function openMenu() {
      drawerNav.classList.remove("drawer-hidden");
      drawerNav.classList.add("drawer-visible");
      drawerBackdrop.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeMenu() {
      drawerNav.classList.remove("drawer-visible");
      drawerNav.classList.add("drawer-hidden");
      drawerBackdrop.classList.add("hidden");
      document.body.style.overflow = "";
    }

    if (btnOpenMenu) btnOpenMenu.addEventListener("click", openMenu);
    if (btnFloatingMenu) btnFloatingMenu.addEventListener("click", openMenu);
    if (btnCloseMenu) btnCloseMenu.addEventListener("click", closeMenu);
    if (drawerBackdrop) drawerBackdrop.addEventListener("click", closeMenu);

    function toggleMenu(id) {
      const sub = document.getElementById(id);
      const icon = document.getElementById("icon-" + id);
      if (sub.classList.contains("hidden")) {
        sub.classList.remove("hidden");
        if (icon) icon.classList.replace("fa-chevron-down", "fa-chevron-up");
      } else {
        sub.classList.add("hidden");
        if (icon) icon.classList.replace("fa-chevron-up", "fa-chevron-down");
      }
    }

    const btnBackToTop = document.getElementById("btn-back-to-top");
    if (btnBackToTop) {
      btnBackToTop.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    function submitPhanAnh(e) {
      e.preventDefault();
      document.getElementById("form-phan-anh").reset();
      const successBox = document.getElementById("pa-success");
      successBox.classList.remove("hidden");
      setTimeout(() => { successBox.classList.add("hidden"); }, 5000);
    }
  
    // ==================== TỰ ĐỘNG ĐỒNG BỘ BÀI VIẾT MỚI TỪ GOOGLE SHEETS ====================
    function loadPublicDynamicNews() {
      const sheetUrl = "https://docs.google.com/spreadsheets/d/1C2u2GmATG29cu9WIni7oZcYt85XFtjgGTQsf_b9thfQ/gviz/tq?tqx=out:json";
      const container = document.getElementById("dynamic-public-news");
      if (!container) return;

      fetch(sheetUrl)
        .then(res => res.text())
        .then(text => {
          const match = text.match(/setResponse\(([\s\S]*)\);?/) /* fixed */;
          if (!match) return;
          const jsonStr = match[1].endsWith(';') ? match[1].slice(0, -1) : match[1];
          const data = JSON.parse(jsonStr);
          const rows = data.table.rows;
          if (!rows || rows.length === 0) return;

          const reversedRows = [...rows].reverse();
          let html = "";

          reversedRows.forEach((r) => {
            const c = r.c || [];
            const timestamp = c[0] ? (c[0].f || c[0].v || "") : "";
            const date = c[1] ? (c[1].f || c[1].v || "") : "";
            const category = (c[2] ? (c[2].v || "") : "").trim() || "Tin Lương Hậu";
            const title = (c[3] ? (c[3].v || "") : "").trim();
            const content = (c[4] ? (c[4].v || "") : "").trim();
            const rawImg = (c[5] ? (c[5].v || "") : "").trim();

            if (!title && !content) return;

            let fileId = "";
            if (rawImg) {
              const idMatch = rawImg.match(/id=([a-zA-Z0-9_-]+)/) || rawImg.match(/\/d\/([a-zA-Z0-9_-]+)/);
              if (idMatch) fileId = idMatch[1];
            }
            const imgSrc = fileId ? ("https://drive.google.com/thumbnail?id=" + fileId + "&sz=w800") : "";

            html += '<article class="flex gap-2.5 items-start bg-white p-2.5 rounded-lg border border-red-100 shadow-sm active:bg-gray-50 transition">' +
              '<div class="w-24 sm:w-28 aspect-video flex-shrink-0 rounded-lg overflow-hidden bg-gray-100 relative">' +
                '<img src="' + imgSrc + '" alt="' + title + '" class="w-full h-full object-cover">' +
                '<span class="absolute top-1 left-1 bg-red-700 text-white text-[8px] font-black px-1.5 py-0.5 rounded uppercase">' + category + '</span>' +
              '</div>' +
              '<div class="flex-1 min-w-0">' +
                '<h4 class="text-xs font-bold text-gray-900 leading-snug line-clamp-2 hover:text-red-700">' + title + '</h4>' +
                '<p class="text-[11px] text-gray-600 line-clamp-2 mt-0.5 leading-tight">' + content + '</p>' +
                '<p class="text-[10px] text-[#2563eb] font-medium mt-1 flex items-center gap-1">' +
                  '<i class="fa-regular fa-calendar-days text-[9px]"></i> ' + (date || timestamp) +
                '</p>' +
              '</div>' +
            '</article>';
          });

          if (html) {
            container.innerHTML = '<div class="flex items-center gap-1.5 text-xs font-bold text-red-800 border-b border-red-200 pb-1 mt-2"><i class="fa-solid fa-clock-rotate-left"></i> <span>Tin mới đăng từ Ban điều hành:</span></div>' + html;
          }
        })
        .catch(err => console.error("Lỗi nạp tin công khai:", err));
    }
    window.addEventListener("DOMContentLoaded", loadPublicDynamicNews);

  </script>
