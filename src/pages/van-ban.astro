---
/**
 * src/pages/van-ban.astro
 * Hệ thống văn bản 3 cấp: Trung ương - Thành phố Huế - Phường Hương Thủy
 * Cập nhật từ src/data/du-lieu-moi.json
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import DriveAttachmentList from "../components/DriveAttachmentList.astro";
import data from "../data/du-lieu-moi.json";

const { vanBan3Cap, nhanSuCanBo } = data;
const { trungUong, thanhPho, phuongHuongThuy } = vanBan3Cap;
---

<BaseLayout
  title="Văn bản chỉ đạo 3 cấp — TDP Lương Hậu"
  description="Hệ thống văn bản chỉ đạo 3 cấp: Trung ương, UBND thành phố Huế và Đảng ủy phường Hương Thủy triển khai tại Tổ dân phố Lương Hậu."
  canonical={`${Astro.site?.origin ?? ""}/van-ban`}
>
  <div class="wrap" style="max-width: 1100px; margin: 0 auto; padding: 16px;">
    <!-- Breadcrumbs -->
    <nav style="font-size: 13px; color: #64748b; margin-bottom: 16px;">
      <a href="/" style="color: #93061d; text-decoration: none; font-weight: 500;">Trang chủ</a> / 
      <span style="color: #0f172a; font-weight: 600;">Văn bản 3 cấp</span>
    </nav>

    <!-- Header phần văn bản -->
    <div style="background: #93061d; color: #fff; border-radius: 16px; padding: 20px 24px; margin-bottom: 24px; border-bottom: 3px solid #FFC72C;">
      <h1 style="font-size: 20px; font-weight: 800; color: #FFC72C; margin: 0 0 6px 0; text-transform: uppercase;">
        📜 Hệ thống văn bản chỉ đạo 3 cấp triển khai tại địa bàn
      </h1>
      <p style="font-size: 13px; color: #fecdd3; margin: 0;">
        Trung ương · UBND thành phố Huế · Đảng ủy &amp; UBND phường Hương Thủy
      </p>
    </div>

    <!-- 1. VĂN BẢN THÀNH PHỐ HUẾ (ĐẶC BIỆT KẾ HOẠCH 333/KH-UBND) -->
    <section style="background: #fff; border-radius: 16px; padding: 20px; border: 1px solid #fed7aa; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
      <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #ea580c; padding-bottom: 8px; margin-bottom: 16px;">
        <h2 style="font-size: 17px; font-weight: 700; color: #9a3412; margin: 0; display: flex; align-items: center; gap: 8px;">
          <span>🏛️</span> VĂN BẢN THÀNH PHỐ HUẾ
        </h2>
        <span style="background: #ffedd5; color: #c2410c; font-size: 11px; font-weight: bold; padding: 3px 8px; border-radius: 6px;">
          Trọng tâm 2026
        </span>
      </div>

      {thanhPho.map((doc) => (
        <div style="background: #fff7ed; border-radius: 12px; padding: 18px; border: 1px solid #fdba74;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 8px;">
            <div>
              <span style="background: #c2410c; color: #fff; font-size: 12px; font-weight: bold; padding: 2px 8px; border-radius: 4px;">
                {doc.soHieu}
              </span>
              <span style="font-size: 12px; color: #7c2d12; margin-left: 8px; font-weight: 500;">
                📅 Ngày ban hành: {doc.ngayBanHanh || doc.ngay}
              </span>
            </div>
            <div style="font-size: 12px; color: #9a3412;">
              <b>Người ký:</b> {doc.nguoiKy} · <b>Lĩnh vực:</b> {doc.linhVuc}
            </div>
          </div>
          <h3 style="font-size: 15px; font-weight: 700; color: #7c2d12; margin: 12px 0 8px 0; line-height: 1.5;">
            {doc.trichYeu}
          </h3>

          {doc.linkNguonChinhThong && (
            <div style="margin: 8px 0; font-size: 12px;">
              🔗 <b>Nguồn chính thống:</b>{" "}
              <a
                href={doc.linkNguonChinhThong}
                target="_blank"
                rel="noopener noreferrer"
                style="color: #0b4d97; text-decoration: underline; word-break: break-all; font-weight: 600;"
              >
                {doc.linkNguonChinhThong} ↗
              </a>
            </div>
          )}

          {/* Tệp đính kèm kết nối Google Drive API v3 */}
          <DriveAttachmentList
            title="Phụ lục & Tệp đính kèm Kế hoạch 333 (Google Drive)"
          />
        </div>
      ))}
    </section>

    <!-- 2. VĂN BẢN ĐẢNG ỦY PHƯỜNG HƯƠNG THỦY -->
    <section style="background: #fff; border-radius: 16px; padding: 20px; border: 1px solid #fecdd3; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
      <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #e11d48; padding-bottom: 8px; margin-bottom: 16px;">
        <h2 style="font-size: 17px; font-weight: 700; color: #9f1239; margin: 0; display: flex; align-items: center; gap: 8px;">
          <span>🚩</span> VĂN BẢN ĐẢNG ỦY PHƯỜNG HƯƠNG THỦY (ĐỢT THÁNG 9/2026)
        </h2>
        <span style="background: #ffe4e6; color: #be123c; font-size: 11px; font-weight: bold; padding: 3px 8px; border-radius: 6px;">
          {phuongHuongThuy.length} văn bản
        </span>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 14px;">
        {phuongHuongThuy.map((doc) => (
          <div style="background: #fff1f2; border-radius: 10px; padding: 14px; border: 1px solid #fecdd3; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <b style="color: #9f1239; font-size: 13.5px;">{doc.soHieu}</b>
                <span style="font-size: 11px; color: #881337;">📅 {doc.ngay}</span>
              </div>
              <p style="font-size: 12.5px; color: #1e293b; line-height: 1.5; margin: 0 0 8px 0; font-weight: 500;">
                {doc.trichYeu}
              </p>
            </div>
            <div style="font-size: 11.5px; color: #9f1239; border-top: 1px dashed #fecdd3; padding-top: 6px;">
              ✍️ <b>Người ký:</b> {doc.nguoiKy}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. VĂN BẢN TRUNG ƯƠNG -->
    <section style="background: #fff; border-radius: 16px; padding: 20px; border: 1px solid #cbd5e1; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
      <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #475569; padding-bottom: 8px; margin-bottom: 16px;">
        <h2 style="font-size: 17px; font-weight: 700; color: #1e293b; margin: 0; display: flex; align-items: center; gap: 8px;">
          <span>⭐</span> VĂN KIỆN, CHỈ THỊ &amp; NGHỊ QUYẾT TRUNG ƯƠNG
        </h2>
        <span style="background: #f1f5f9; color: #475569; font-size: 11px; font-weight: bold; padding: 3px 8px; border-radius: 6px;">
          {trungUong.length} văn bản
        </span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 10px;">
        {trungUong.map((doc) => (
          <div style="background: #f8fafc; border-radius: 8px; padding: 12px 16px; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <div style="flex: 1; min-width: 250px;">
              <b style="color: #0f172a; font-size: 13px;">{doc.soHieu}</b>
              <span style="color: #64748b; font-size: 12px; margin-left: 8px;">({doc.coQuan} · {doc.ngay})</span>
              <div style="font-size: 12.5px; color: #334155; margin-top: 2px;">
                {doc.trichYeu}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Nút quay lại trang chủ -->
    <div style="margin-top: 24px; text-align: center;">
      <a href="/" style="display: inline-block; padding: 8px 18px; background: #93061d; color: #fff; border-radius: 8px; text-decoration: none; font-size: 13px; font-weight: 600;">
        ← Về Cổng thông tin điện tử Tổ dân phố
      </a>
    </div>
  </div>
</BaseLayout>
