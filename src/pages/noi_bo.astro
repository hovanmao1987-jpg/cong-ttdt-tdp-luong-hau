<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Khu Vực Nội Bộ Chi Bộ - Cổng Thông Tin TDP Lương Hậu</title>
  <script src="https://cdn.tailwindcss.com">
    // ==================== TỰ ĐỘNG ĐỒNG BỘ TIN TỨC TỪ GOOGLE SHEETS ====================
    function loadDynamicNews() {
      const sheetUrl = "https://docs.google.com/spreadsheets/d/1C2u2GmATG29cu9WIni7oZcYt85XFtjgGTQsf_b9thfQ/gviz/tq?tqx=out:json";
      const container = document.getElementById("dynamic-news-list");
      if (!container) return;

      fetch(sheetUrl)
        .then(res => res.text())
        .then(text => {
          const match = text.match(/setResponse\(([\s\S]*)\);?/) /* fixed */;
          if (!match) return;
          const jsonStr = match[1].endsWith(';') ? match[1].slice(0, -1) : match[1];
          const data = JSON.parse(jsonStr);
          const rows = data.table.rows;
          if (!rows || rows.length === 0) {
            container.innerHTML = '<div class="p-4 bg-white rounded-xl border border-dashed border-gray-300 text-center text-xs text-gray-500">Chưa có bản tin mới nào. Bấm nút <strong>+ Đăng tin mới</strong> để thêm thông báo đầu tiên.</div>';
            return;
          }

          // Đảo ngược mảng để tin mới nhất lên đầu
          const reversedRows = [...rows].reverse();
          let html = "";

          reversedRows.forEach((r, idx) => {
            const c = r.c || [];
            const timestamp = c[0] ? (c[0].f || c[0].v || "") : "";
            const date = c[1] ? (c[1].f || c[1].v || "") : "";
            const category = (c[2] ? (c[2].v || "") : "").trim() || "Tin tức Chi bộ";
            const title = (c[3] ? (c[3].v || "") : "").trim();
            const content = (c[4] ? (c[4].v || "") : "").trim();
            const rawImg = (c[5] ? (c[5].v || "") : "").trim();

            if (!title && !content) return;

            // Xử lý badge chuyên mục
            let badgeClass = "bg-red-700 text-white";
            if (category.includes("Nghị quyết")) badgeClass = "bg-[#8b0018] text-yellow-300 border border-yellow-400/40";
            else if (category.includes("Thông báo")) badgeClass = "bg-amber-600 text-white";
            else if (category.includes("Chủ nhật xanh")) badgeClass = "bg-emerald-700 text-white";
            else if (category.includes("Lương Hậu")) badgeClass = "bg-blue-700 text-white";

            // Xử lý hình ảnh Google Drive
            let imgHtml = "";
            if (rawImg) {
              let fileId = "";
              const idMatch = rawImg.match(/id=([a-zA-Z0-9_-]+)/) || rawImg.match(/\/d\/([a-zA-Z0-9_-]+)/);
              if (idMatch) fileId = idMatch[1];
              if (fileId) {
                const imgThumb = "https://drive.google.com/thumbnail?id=" + fileId + "&sz=w800";
                imgHtml = '<div class="w-full aspect-[16/9] bg-gray-100 relative overflow-hidden rounded-lg mb-2"><img src="' + imgThumb + '" alt="' + title + '" class="w-full h-full object-cover" loading="lazy" onerror="this.parentElement.style.display=\'none\'"></div>';
              }
            }

            html += '<article class="bg-white rounded-xl border border-gray-200 shadow-sm p-3.5 space-y-2 hover:border-red-300 transition">' +
              '<div class="flex items-center justify-between gap-2">' +
                '<span class="text-[10px] font-black uppercase px-2 py-0.5 rounded-full ' + badgeClass + '">' + category + '</span>' +
                '<span class="text-[10.5px] text-gray-500 font-medium flex items-center gap-1">' +
                  '<i class="fa-regular fa-calendar-days text-[10px]"></i> ' + (date || timestamp) +
                '</span>' +
              '</div>' +
              imgHtml +
              '<h3 class="text-xs sm:text-sm font-bold text-gray-900 leading-snug hover:text-red-700 transition">' + title + '</h3>' +
              '<div class="text-[11.5px] text-gray-600 leading-relaxed whitespace-pre-line bg-gray-50/70 p-2.5 rounded-lg border border-gray-100">' + content + '</div>' +
            '</article>';
          });

          container.innerHTML = html || '<div class="p-4 bg-white rounded-xl border border-dashed border-gray-300 text-center text-xs text-gray-500">Chưa có bản tin nào.</div>';
        })
        .catch(err => {
          console.error("Lỗi nạp tin tức:", err);
          container.innerHTML = '<div class="p-3 bg-red-50 text-red-700 rounded-lg text-xs">Không thể kết nối đến dữ liệu bản tin. Vui lòng thử lại sau.</div>';
        });
    }

  </script>
