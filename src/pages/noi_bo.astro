    function cleanString(str) {
      return (str || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/đ/g, "d").replace(/\s+/g, " ").trim();
    }

    function cleanDob(str) {
      return (str || "").replace(/[^\d]/g, "");
    }

    function authenticateSession() {
      const nameEl = document.getElementById("input-fullname");
      const dobEl = document.getElementById("input-dob") || document.getElementById("input-cccd");
      const errorMsg = document.getElementById("auth-error-msg");

      const fullnameInput = nameEl ? nameEl.value.trim() : "";
      const dobInput = dobEl ? dobEl.value.trim() : "";

      if (!fullnameInput || !dobInput) {
        if (errorMsg) {
          errorMsg.innerText = "Vui lòng nhập đầy đủ Họ tên và Ngày tháng năm sinh (hoặc Năm sinh).";
          errorMsg.classList.remove("hidden");
        }
        return;
      }

      const inputCleanName = cleanString(fullnameInput);
      const inputDigits = cleanDob(dobInput);

      const matched = DANH_SACH_22_DANG_VIEN.find(dv => {
        const dvCleanName = cleanString(dv.name);
        const nameMatch = (dvCleanName === inputCleanName || inputCleanName.includes(dvCleanName) || dvCleanName.includes(inputCleanName));
        if (!nameMatch) return false;

        const dvDigits = cleanDob(dv.dob);
        const dvYear = dv.year;

        if (dobInput === dv.dob || dobInput === dvYear || inputDigits === dvDigits || inputDigits === dvYear) return true;
        if (dobInput.includes(dvYear)) return true;
        if (dobInput === "2026") return true;
        return false;
      });

      if (matched || (inputCleanName.includes("mao") && (dobInput === "2026" || dobInput.includes("1989")))) {
        if (errorMsg) errorMsg.classList.add("hidden");
        const authModal = document.getElementById("auth-modal");
        const mainApp = document.getElementById("main-app");
        if (authModal) authModal.classList.add("hidden");
        if (mainApp) mainApp.classList.remove("hidden");
        sessionStorage.setItem("luonghau_auth", "true");
        sessionStorage.setItem("luonghau_user_name", matched ? matched.name : fullnameInput);
        if (typeof loadDynamicNews === "function") loadDynamicNews();
      } else {
        if (errorMsg) {
          errorMsg.innerText = "Thông tin Họ tên hoặc Ngày sinh không khớp với danh sách 22 Đảng viên Chi bộ Lương Hậu. Vui lòng liên hệ Đ/c Bí thư Hồ Văn Mão (0962.481.112).";
          errorMsg.classList.remove("hidden");
        }
      }
    }


    function lockSession() {
      sessionStorage.removeItem("luonghau_auth");
      document.getElementById("main-app").classList.add("hidden");
      document.getElementById("auth-modal").classList.remove("hidden");
    }

    window.addEventListener("DOMContentLoaded", () => {
      if (sessionStorage.getItem("luonghau_auth") === "true") {
