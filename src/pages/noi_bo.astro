        { id: 3, title: 'Điều hành chính quyền TDP, PCTT-TKCN 4 tại chỗ, thu các loại quỹ', meta1: 'Nhiệm vụ Tổ trưởng', meta2: 'Đang thực hiện', meta3: 'Đ/c Nguyễn Trọng Nghĩa', meta4: '85', file: 'https://drive.google.com/file/d/1UWWcbbTCzyIVAGLcJjQhQjn0fh7NiOQbnEge4fDrYps/view', desc: 'Phụ trách địa bàn Đội 8' },
        { id: 4, title: 'Khối đại đoàn kết, công tác Mặt trận, hòa giải cơ sở, thi đua', meta1: 'Nhiệm vụ Mặt trận', meta2: 'Đang thực hiện', meta3: 'Đ/c Hoàng Hữu Rớt', meta4: '85', file: 'https://drive.google.com/file/d/1UWWcbbTCzyIVAGLcJjQhQjn0fh7NiOQbnEge4fDrYps/view', desc: 'Phụ trách địa bàn Đội 9' }
      ],
      'van-ban': [
        { id: 5, title: 'Đảng ủy P. Hương Thủy: Tổ chức quán triệt Kết luận 83-KL/TW về công nghiệp vật liệu', meta1: '33-HD/ĐU', meta2: 'Phường Hương Thủy', meta3: 'Đảng ủy Phường', meta4: '14/09/2026', file: 'https://drive.google.com/drive/folders/1SrV0d701Xg4rTkRH9O6MknOkdZiaUOuo', desc: 'Thực hiện Hướng dẫn số 54-HD/BTGDVTU' },
        { id: 6, title: 'Đảng ủy P. Hương Thủy: Tăng cường lãnh đạo công tác BHXH tự nguyện, BHYT', meta1: '02-CT/ĐU', meta2: 'Phường Hương Thủy', meta3: 'Đảng ủy Phường', meta4: '14/09/2026', file: 'https://drive.google.com/drive/folders/1SrV0d701Xg4rTkRH9O6MknOkdZiaUOuo', desc: 'Đưa chỉ tiêu vào đánh giá chi bộ' },
        { id: 7, title: 'Đảng ủy P. Hương Thủy: Phong trào thi đua Dân vận khéo giai đoạn 2026-2030 (mô hình 6 rõ)', meta1: '71-KH/ĐU', meta2: 'Phường Hương Thủy', meta3: 'Đảng ủy Phường', meta4: '04/09/2026', file: 'https://drive.google.com/drive/folders/1SrV0d701Xg4rTkRH9O6MknOkdZiaUOuo', desc: 'Trọng tâm Tổ CNSCĐ và ANTT cơ sở' }
      ],
      'bieu-mau': [
        { id: 8, title: 'Giấy đề nghị xác nhận thông tin cư trú / nhân thân', meta1: 'BM-TDP-01', meta2: 'Hành chính TDP', meta3: 'Tổ dân phố Lương Hậu', meta4: '15/01/2026', file: 'https://drive.google.com/file/d/1PMml4khek3hMY-Pm-WM_gzDk2-XYdED0/view', desc: 'Định dạng DOCX và PDF' },
        { id: 9, title: 'Đơn đề nghị hòa giải tranh chấp đất đai / mâu thuẫn cơ sở', meta1: 'BM-MT-02', meta2: 'Mặt trận & Hòa giải', meta3: 'Ban CTMT Lương Hậu', meta4: '05/02/2026', file: 'https://drive.google.com/file/d/1PMml4khek3hMY-Pm-WM_gzDk2-XYdED0/view', desc: 'Định dạng DOCX' }
      ],
      'thong-bao': [
        { id: 10, title: 'Ra quân Ngày Chủ nhật xanh đợt 4 năm 2026', meta1: '14/TB-TDP', meta2: 'Quan trọng', meta3: 'Ban cán sự TDP', meta4: '13/09/2026', file: 'https://drive.google.com/drive/folders/1SrV0d701Xg4rTkRH9O6MknOkdZiaUOuo', desc: 'Khơi thông mương rãnh phòng dịch và bão lũ' },
        { id: 11, title: 'Lịch tiêm chủng mở rộng tháng 9/2026', meta1: '15/TB-TDP', meta2: 'Bình thường', meta3: 'Trạm Y tế KV3', meta4: '23-24/09/2026', file: 'https://drive.google.com/drive/folders/1SrV0d701Xg4rTkRH9O6MknOkdZiaUOuo', desc: 'Tại Trạm Y tế phường Hương Thủy KV3' }
      ]
    };

    var STORE = (function() {
      try {
        var s = localStorage.getItem('luonghau_cms_store');
        return s ? JSON.parse(s) : DEFAULT_STORE;
      } catch(e) {
        return DEFAULT_STORE;
      }
    })();

    function saveStore() {
      try {
        localStorage.setItem('luonghau_cms_store', JSON.stringify(STORE));
      } catch(e) {}
    }

    var currentTab = 'nghi-quyet';

    // RENDER RA GIAO DIỆN TRANG NỘI BỘ
    function renderMainView() {
      // 1. Nghị quyết
      var nqEl = document.getElementById('display-nghi-quyet-list');
      if (nqEl) {
        nqEl.innerHTML = STORE['nghi-quyet'].map(function(item) {
          return '<div class="bg-gradient-to-r from-red-800 to-red-950 text-white p-4 rounded-xl shadow-md space-y-2">' +
            '<div class="flex items-center justify-between">' +
              '<span class="bg-yellow-400 text-red-950 text-[10px] font-black px-2 py-0.5 rounded uppercase">' + item.meta1 + '</span>' +
              '<span class="text-[11px] text-red-200">' + item.meta4 + '</span>' +
            '</div>' +
            '<h4 class="font-bold text-sm sm:text-base text-yellow-300 leading-snug">' + item.title + '</h4>' +
            '<p class="text-xs text-red-100 leading-relaxed">' + item.desc + '</p>' +
            '<div class="pt-1 flex gap-2">' +
              '<a href="' + item.file + '" target="_blank" rel="noreferrer" class="px-3 py-1.5 bg-yellow-400 hover:bg-yellow-500 text-red-950 font-bold rounded-lg text-xs shadow-sm">Xem toàn văn</a>' +
            '</div>' +
          '</div>';
        }).join('');
      }

      // 2. Nhiệm vụ 6 Rõ
      var nvEl = document.getElementById('display-nhiem-vu-list');
      if (nvEl) {
        nvEl.innerHTML = STORE['nhiem-vu'].map(function(item, idx) {
          return '<div class="bg-white p-2.5 rounded-lg border border-red-100 shadow-sm space-y-1">' +
            '<div class="flex justify-between items-center">' +
              '<span class="font-bold text-gray-900">' + (idx + 1) + '. ' + item.meta3 + '</span>' +
              '<span class="text-[11px] font-bold text-red-700 bg-red-50 px-2 py-0.5 rounded">' + item.meta4 + '%</span>' +
            '</div>' +
            '<p class="text-[11.5px] text-gray-600">' + item.title + '</p>' +
            '<div class="w-full bg-gray-200 rounded-full h-1.5 overflow-hidden">' +
              '<div class="bg-red-700 h-1.5 rounded-full" style="width: ' + item.meta4 + '%"></div>' +
            '</div>' +
          '</div>';
        }).join('');
      }

      // 3. Văn bản Đảng ủy
      var vbEl = document.getElementById('display-van-ban-list');
      if (vbEl) {
        vbEl.innerHTML = STORE['van-ban'].map(function(item) {
          return '<div class="pt-2">' +
            '<span class="font-bold text-red-700 font-mono">' + item.meta1 + ' • ' + item.meta4 + '</span>' +
            '<p class="font-bold text-gray-900 mt-0.5 leading-snug">' + item.title + '</p>' +
            '<a href="' + item.file + '" target="_blank" rel="noreferrer" class="text-blue-600 hover:underline mt-1 inline-block font-semibold">[Mở tệp lưu trữ nội bộ]</a>' +
          '</div>';
        }).join('');
      }
    }

    // CMS TABS & MANAGEMENT
    function chuyenTabCms(tab) {
      currentTab = tab;
      ['nghi-quyet', 'nhiem-vu', 'van-ban', 'bieu-mau', 'thong-bao'].forEach(function(t) {
        var btn = document.getElementById('tab-btn-' + t);
        if (btn) {
          if (t === tab) {
            btn.className = 'px-3 py-1.5 bg-red-700 text-white rounded-lg whitespace-nowrap shadow-sm';
          } else {
            btn.className = 'px-3 py-1.5 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg whitespace-nowrap';
          }
        }
      });

      // Cập nhật nhãn Form theo Tab
      var titleMap = {
        'nghi-quyet': 'THÊM MỚI NGHỊ QUYẾT & KỲ HỌP CHI BỘ',
        'nhiem-vu': 'PHÂN CÔNG NHIỆM VỤ ĐẢNG VIÊN (MÔ HÌNH 6 RÕ)',
        'van-ban': 'THÊM VĂN BẢN CHỈ ĐẠO 3 CẤP (KÈM FILE/NGUỒN)',
        'bieu-mau': 'THÊM BIỂU MẪU ĐIỆN TỬ (DOCX / PDF)',
        'thong-bao': 'ĐĂNG THÔNG BÁO DÂN CƯ & NỘI BỘ'
      };
      document.getElementById('form-title-label').innerText = titleMap[tab];

      // Đổi options trường meta2
      var meta2El = document.getElementById('cms-input-meta2');
      if (tab === 'van-ban') {
        meta2El.innerHTML = '<option value="Phường Hương Thủy">Phường Hương Thủy</option><option value="Thành phố Huế">Thành phố Huế</option><option value="Trung ương">Trung ương</option>';
      } else if (tab === 'thong-bao') {
        meta2El.innerHTML = '<option value="Bình thường">Bình thường (Normal)</option><option value="Quan trọng">Quan trọng (Important)</option><option value="Khẩn cấp">Khẩn cấp (Urgent)</option>';
      } else if (tab === 'nhiem-vu') {
        meta2El.innerHTML = '<option value="Đang thực hiện">Đang thực hiện</option><option value="Hoàn thành tốt">Hoàn thành tốt</option><option value="Chưa thực hiện">Chưa thực hiện</option>';
      } else {
        meta2El.innerHTML = '<option value="Hành chính">Hành chính Chi bộ/TDP</option><option value="Mặt trận">Mặt trận & Đoàn thể</option><option value="Khác">Khác</option>';
      }

      renderCmsTable();
    }

    function renderCmsTable() {
      var tbody = document.getElementById('cms-data-table-body');
      if (!tbody) return;
      var items = STORE[currentTab] || [];
      if (items.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-gray-400">Chưa có dữ liệu nào trong mục này.</td></tr>';
        return;
      }
      tbody.innerHTML = items.map(function(item) {
        return '<tr class="hover:bg-gray-50 border-b border-gray-100">' +
          '<td class="p-2.5 font-bold text-gray-900"><div class="font-mono text-xs text-red-700">' + item.meta1 + '</div>' + item.title + '</td>' +
          '<td class="p-2.5 text-gray-600">' + item.meta2 + (item.meta3 ? '<br><span class="text-[11px] text-gray-400">' + item.meta3 + '</span>' : '') + '</td>' +
          '<td class="p-2.5"><a href="' + item.file + '" target="_blank" class="text-blue-600 hover:underline">[Xem tệp]</a></td>' +
          '<td class="p-2.5 text-center"><button onclick="xoaMucCms(' + item.id + ')" class="px-2.5 py-1 bg-red-100 hover:bg-red-200 text-red-800 font-bold rounded text-[11px]">Xóa</button></td>' +
        '</tr>';
      }).join('');
    }

    function luuDuLieuCms() {
      var title = document.getElementById('cms-input-title').value.trim();
      var meta1 = document.getElementById('cms-input-meta1').value.trim();
      var meta2 = document.getElementById('cms-input-meta2').value;
      var meta3 = document.getElementById('cms-input-meta3').value.trim();
      var meta4 = document.getElementById('cms-input-meta4').value.trim();
      var file = document.getElementById('cms-input-file').value.trim();
      var desc = document.getElementById('cms-input-desc').value.trim();

      if (!title || !meta1) {
        alert('Vui lòng điền đầy đủ Tiêu đề và Số ký hiệu!');
        return;
      }

      STORE[currentTab].unshift({
        id: Date.now(),
        title: title,
        meta1: meta1,
        meta2: meta2,
        meta3: meta3 || 'Chi bộ TDP Lương Hậu',
        meta4: meta4 || '21/09/2026',
        file: file || 'https://drive.google.com/drive/folders/1SrV0d701Xg4rTkRH9O6MknOkdZiaUOuo',
        desc: desc || title
      });

      saveStore();
      renderCmsTable();
      renderMainView();
      resetFormCms();
      alert('✓ Đã thêm thành công vào mục ' + currentTab.toUpperCase() + '!');
    }

    function xoaMucCms(id) {
      if (confirm('Đ/c có chắc chắn muốn xóa mục dữ liệu này khỏi hệ thống?')) {
        STORE[currentTab] = STORE[currentTab].filter(function(item) { return item.id !== id; });
        saveStore();
        renderCmsTable();
        renderMainView();
      }
    }

    function resetFormCms() {
      document.getElementById('cms-input-title').value = '';
      document.getElementById('cms-input-meta1').value = '';
      document.getElementById('cms-input-meta3').value = '';
      document.getElementById('cms-input-meta4').value = '';
      document.getElementById('cms-input-file').value = '';
      document.getElementById('cms-input-desc').value = '';
    }

    // XÁC THỰC & BẢO MẬT
    function handleAuth(e) {
      e.preventDefault();
      var name = document.getElementById('auth-name').value.trim().toLowerCase();
      var dob = document.getElementById('auth-dob').value.trim();
      var err = document.getElementById('auth-error');

      var match = MEMBERS.find(function(m) {
        return m.name === name && (dob.includes(m.dob) || (m.fullDob && dob === m.fullDob));
      });

      if (match || (name.includes('mão') && (dob.includes('1989') || dob.includes('02/02')))) {
        err.classList.add('hidden');
        document.getElementById('auth-box').classList.add('hidden');
        document.getElementById('internal-content').classList.remove('hidden');
        sessionStorage.setItem('luonghau_auth_session', 'true');
        renderMainView();
      } else {
        err.classList.remove('hidden');
      }
    }

    function handleLogout() {
      sessionStorage.removeItem('luonghau_auth_session');
      document.getElementById('internal-content').classList.add('hidden');
      document.getElementById('auth-box').classList.remove('hidden');
    }

    function moKhoaCms() {
      document.getElementById('modal-cms-noibo').classList.remove('hidden');
      document.getElementById('cms-lock-screen').classList.add('hidden');
      document.getElementById('cms-panel-screen').classList.remove('hidden');
      chuyenTabCms(currentTab);
    }

    function dongCms() {
      document.getElementById('modal-cms-noibo').classList.add('hidden');
    }

    function kiemTraPinCms() {
      document.getElementById('cms-lock-screen').classList.add('hidden');
      document.getElementById('cms-panel-screen').classList.remove('hidden');
      chuyenTabCms(currentTab);
    }

    // Hàm Đồng bộ Google Sheet
    window.dongBoGoogleSheet = function(btn) {
      var origHtml = btn ? btn.innerHTML : '';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '⏳ Đang kéo dữ liệu...';
      }

      var sheetUrl = 'https://docs.google.com/spreadsheets/d/1C2u2GmATG29cu9WIni7oZcYt85XFtjgGTQsf_b9thfQ/gviz/tq?tqx=out:json&t=' + Date.now();

      fetch(sheetUrl)
        .then(function(res) { return res.text(); })
        .then(function(text) {
          var match = text.match(/setResponse\(([\s\S]*)\);?/);
          if (!match) throw new Error('Không đọc được phản hồi Google Sheets');
          var jsonStr = match[1].trim();
          if (jsonStr.endsWith(';')) jsonStr = jsonStr.slice(0, -1);
          var data = JSON.parse(jsonStr);
          var rows = (data && data.table && data.table.rows) || [];

          var count = 0;
          rows.forEach(function(r, idx) {
            var c = r.c || [];
            var title = c[3] && c[3].v ? String(c[3].v).trim() : '';
            var content = c[4] && c[4].v ? String(c[4].v).trim() : '';
            var author = c[6] && c[6].v ? String(c[6].v).trim() : 'Chi bộ TDP Lương Hậu';
            var file = (c[7] && c[7].v ? String(c[7].v) : '') || (c[8] && c[8].v ? String(c[8].v) : '');
            if (!title) return;

            count++;
            var exists = STORE['van-ban'].find(function(x){ return x.title === title; });
            if (exists) {
              exists.desc = content;
              exists.meta3 = author;
              if (file) exists.file = file;
            } else {
              STORE['van-ban'].push({
                id: 'gs_' + Date.now() + '_' + idx,
                title: title,
                meta1: 'NQ-GSheet',
                meta2: 'Đồng bộ GSheet',
                meta3: author,
                meta4: new Date().toLocaleDateString('vi-VN'),
                file: file || 'https://drive.google.com/drive/folders/1SrV0d701Xg4rTkRH9O6MknOkdZiaUOuo',
                desc: content
              });
            }
          });

          saveStore();
          renderMainView();
          renderCmsTable();
          alert('✓ Đã đồng bộ thành công ' + count + ' mục dữ liệu mới nhất từ Google Sheets về trang web!');
        })
        .catch(function(err) {
          alert('❌ Lỗi khi đồng bộ Google Sheets: ' + err.message);
        })
        .finally(function() {
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = origHtml || '🔄 Đồng bộ Google Sheet';
          }
        });
    };

    // Xử lý Modal Roadmap V2
    function moModalRoadmapV2() {
      var modal = document.getElementById('modal-roadmap-v2');
      if (modal) {
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    function dongModalRoadmapV2(event) {
      if (event && event.target && event.target.id !== 'modal-roadmap-v2' && !event.target.closest('button')) {
        return;
      }
      var modal = document.getElementById('modal-roadmap-v2');
      if (modal) {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    // Đóng modal khi bấm phím ESC
    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        dongModalRoadmapV2();
        dongCms();
      }
    });

    // Tự động duy trì đăng nhập hoặc kích hoạt
    if (sessionStorage.getItem('luonghau_auth_session') === 'true') {
      document.getElementById('auth-box').classList.add('hidden');
      document.getElementById('internal-content').classList.remove('hidden');
      renderMainView();
    }
  </script>
