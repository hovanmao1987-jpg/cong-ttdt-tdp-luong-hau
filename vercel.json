{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/noi-bo",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/noi-bo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/noi_bo",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/noi-bo", "destination": "/noi-bo.html" },
    { "source": "/noi_bo", "destination": "/noi_bo.html" },
    { "source": "/noi-bo/cms", "destination": "/noi-bo.html" },
    { "source": "/noi_bo/cms", "destination": "/noi_bo.html" },
    { "source": "/noi-bo/dashboard", "destination": "/noi-bo/dashboard/index.html" },
    { "source": "/noi-bo/van-ban-moi", "destination": "/noi-bo/van-ban-moi/index.html" },
    { "source": "/tin-tuc", "destination": "/index.html" },
    { "source": "/thong-bao", "destination": "/index.html" },
    { "source": "/thong-tin", "destination": "/index.html" },
    { "source": "/can-bo", "destination": "/index.html" },
    { "source": "/lich", "destination": "/index.html" },
    { "source": "/van-ban", "destination": "/index.html" },
    { "source": "/chuyen-doi-so", "destination": "/index.html" },
    { "source": "/phan-anh", "destination": "/index.html" },
    { "source": "/lien-he", "destination": "/index.html" },
    { "source": "/thu-vien-chi-bo", "destination": "/thu-vien-chi-bo.html" },

    { "source": "/dang-vien", "destination": "/dang-vien.html" },
    { "source": "/dang-vien/:path*", "destination": "/dang-vien.html" },
    { "source": "/bi-thu", "destination": "/bi-thu.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/:path*", "destination": "/admin.html" },

    { "source": "/cms", "destination": "/admin.html" },
    { "source": "/cms/:path*", "destination": "/admin.html" },
    { "source": "/quan-tri", "destination": "/admin.html" },
    { "source": "/quan-tri/:match*", "destination": "/admin.html" }
  ]
}